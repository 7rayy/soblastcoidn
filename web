    <!-- Scripts -->
    <script>
        // Set Current Year
        document.getElementById('currentYear').textContent = new Date().getFullYear();

        // 1. SPA Tab Navigation Logic
        const tabBtns = document.querySelectorAll('.tab-btn');
        const tabContents = document.querySelectorAll('.tab-content');
        const mobileMenu = document.getElementById('mobile-menu');

        function activateTab(targetId) {
            // Hide all tabs
            tabContents.forEach(content => {
                content.classList.remove('active');
            });
            
            // Reset all buttons style (Desktop)
            document.querySelectorAll('nav .hidden.md\\:block .tab-btn').forEach(btn => {
                btn.className = 'tab-btn px-4 py-2 rounded-md text-sm font-medium transition-colors duration-200 hover:bg-brand-light text-gray-300 hover:text-white';
            });
            // Fix specific button styles like Innovation and Contact
            const desktopNav = document.querySelector('.hidden.md\\:block');
            const innovBtn = desktopNav.querySelector('[data-target="innovation"]');
            if(innovBtn) innovBtn.className = 'tab-btn px-4 py-2 rounded-md text-sm font-medium transition-colors duration-200 hover:bg-brand-light text-brand-highlight flex items-center gap-1';
            
            const contactBtn = desktopNav.querySelector('[data-target="contact"]');
            if(contactBtn) contactBtn.className = 'tab-btn px-4 py-2 rounded-md text-sm font-medium transition-colors duration-200 bg-brand-accent hover:bg-blue-500 text-white';

            // Set active tab content
            const targetSection = document.getElementById(targetId);
            if (targetSection) {
                targetSection.classList.add('active');
            }

            // Set active button state (Desktop only styling)
            const activeBtn = desktopNav.querySelector(`[data-target="${targetId}"]`);
            if (activeBtn && targetId !== 'contact' && targetId !== 'innovation') {
                activeBtn.className = 'tab-btn px-4 py-2 rounded-md text-sm font-medium transition-colors duration-200 bg-brand-light text-white';
            }

            // Close mobile menu if open
            mobileMenu.classList.add('hidden');
            
            // Scroll to top
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Attach click events to all tab buttons
        tabBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                // If the click is on an SVG inside the button, find the closest button
                const target = e.currentTarget; 
                const targetId = target.getAttribute('data-target');
                if (targetId) {
                    activateTab(targetId);
                }
            });
        });

        // Mobile menu toggle
        document.getElementById('mobile-menu-button').addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // 2. Interactive Before & After Slider Logic
        const sliderContainer = document.getElementById('slider-container');
        const sliderBefore = document.getElementById('slider-before');
        const sliderHandle = document.getElementById('slider-handle');
        let isDragging = false;

        function slideMove(e) {
            if (!isDragging) return;
            
            // Get x coordinate relative to container
            let clientX = e.type.includes('mouse') ? e.clientX : e.touches[0].clientX;
            let rect = sliderContainer.getBoundingClientRect();
            let x = clientX - rect.left;
            
            // Bound calculation
            let width = rect.width;
            if (x < 0) x = 0;
            if (x > width) x = width;
            
            let percentage = (x / width) * 100;
            
            // Apply widths
            sliderBefore.style.width = `${percentage}%`;
            sliderHandle.style.left = `${percentage}%`;
        }

        sliderContainer.addEventListener('mousedown', () => isDragging = true);
        sliderContainer.addEventListener('touchstart', () => isDragging = true, {passive: true});
        
        window.addEventListener('mouseup', () => isDragging = false);
        window.addEventListener('touchend', () => isDragging = false);
        
        sliderContainer.addEventListener('mousemove', slideMove);
        sliderContainer.addEventListener('touchmove', slideMove, {passive: true});

        // 3. Quick Project Estimator Logic
        function calculateEstimate() {
            const serviceRate = parseFloat(document.getElementById('est-service').value);
            const areaStr = document.getElementById('est-area').value;
            const resultBox = document.getElementById('est-result');
            const priceText = document.getElementById('est-price');

            if (!areaStr || areaStr <= 0) {
                // Minimal non-alert feedback
                priceText.textContent = "Please enter valid area";
                priceText.classList.replace('text-brand-blue', 'text-red-500');
                resultBox.classList.remove('hidden');
                return;
            }

            const area = parseFloat(areaStr);
            const total = serviceRate * area;

            // Format to IDR Rupiah
            const formattedTotal = new Intl.NumberFormat('id-ID', {
                style: 'currency',
                currency: 'IDR',
                minimumFractionDigits: 0
            }).format(total);

            priceText.classList.replace('text-red-500', 'text-brand-blue');
            priceText.textContent = formattedTotal;
            resultBox.classList.remove('hidden');
        }
    </script>
</body>
